generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============ Enums ============

enum StaffRole {
  ADMIN
  HR
  DESIGNER
  MEDIA
}

enum ApplicationStatus {
  PENDING
  PASS
  FAIL
  FORWARDED
  SELECTED
  DROPPED
}

enum JobStatus {
  OPEN
  CLOSED
}

enum EmploymentType {
  FULLTIME
  PARTTIME
  INTERNSHIP
}

enum SalaryType {
  FIXED
  RANGE
  NEGOTIABLE
}

// ============ User (Staff) ============

model MrStaff {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(50)
  email     String    @unique @db.VarChar(50)
  password  String    @db.VarChar(255)
  role      StaffRole @default(ADMIN)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  reviewedApplications Application[]

  @@map("mr_staff")
}

// ============ User (Client) ============

model Client {
  id Int @id @default(autoincrement())

  companyName   String  @map("company_name") @db.VarChar(100)
  companyDetail String? @map("company_detail") @db.Text
  logoUrl       String? @map("logo_url") @db.Text
  bannerUrl     String? @map("banner_url") @db.Text
  contactName   String  @db.VarChar(100)

  email    String  @unique @db.VarChar(100)
  password String? @db.VarChar(255)

  location String? @db.VarChar(255)
  teamSize BigInt? @db.BigInt

  industryId Int      @map("industry_id")
  industry   Industry @relation(fields: [industryId], references: [id])

  // media
  facebookLink  String? @map("facebook_link") @db.VarChar(255)
  youtubeLink   String? @map("youtube_link") @db.VarChar(255)
  titokLink     String? @map("tiktok_link") @db.VarChar(255)
  instagramLink String? @map("instagram_link") @db.VarChar(255)
  linkedinLink  String? @map("linkedin_link") @db.VarChar(255)
  websiteLink   String? @map("website_link") @db.VarChar(255)

  agreementFileUrl String? @map("agreement_file_url") @db.Text

  isVerified Boolean  @default(false) @map("is_verified")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  jobs            Job[]
  magicLinkTokens MagicLinkToken[]

  @@index([industryId])
  @@map("client")
}

// ============ User (Candidate) ============

model Candidate {
  id Int @id @default(autoincrement())

  name  String  @db.VarChar(100)
  email String  @unique @db.VarChar(100)
  phone String? @db.VarChar(20)

  authProvider String  @map("auth_provider") @db.VarChar(100)
  providerId   String? @map("provider_id") @db.VarChar(100)

  password      String?   @db.Text
  pinCode       BigInt?   @map("pin_code") @db.BigInt
  pinCreatedAt  DateTime? @map("pin_created_at") @db.Timestamptz()
  pinAttempts   Int?      @map("pin_attempts") @db.Integer
  resetVerified Int?      @map("reset_verified") @db.Integer

  isVerified Int @default(0) @map("is_verified") @db.SmallInt

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  applications Application[]

  @@unique([authProvider, providerId])
  @@index([phone])
  @@map("candidate")
}

// ============ Client onboarding tokens ============

model MagicLinkToken {
  id        Int       @id @default(autoincrement())
  token     String    @unique @db.VarChar(255)
  clientId  Int       @map("client_id")
  client    Client    @relation(fields: [clientId], references: [id])
  expiresAt DateTime  @map("expires_at") @db.Timestamptz()
  usedAt    DateTime? @map("used_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  @@index([clientId])
  @@map("magic_link_token")
}

// ============ Jobs ============

model Job {
  id Int @id @default(autoincrement())

  clientId Int    @map("client_id")
  client   Client @relation(fields: [clientId], references: [id])

  title       String  @db.VarChar(150)
  description String? @db.Text

  employmentType EmploymentType @default(FULLTIME) @map("employment_type")

  industryId Int?      @map("industry_id")
  industry   Industry? @relation(fields: [industryId], references: [id])


  provinceId Int?  @map("province_id")
  province Province? @relation(fields: [provinceId], references: [id])
  location String? @db.VarChar(150)

  salaryType  SalaryType @default(NEGOTIABLE) @map("salary_type")
  salaryFixed Int?       @map("salary_fixed")
  salaryMin   Int?       @map("salary_min")
  salaryMax   Int?       @map("salary_max")

  requestedCount Int  @map("requested_count") // e.g. client wants 10
  cvCap          Int? @map("cv_cap") // auto = requestedCount * 2, staff can override

  status JobStatus @default(OPEN)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  applications Application[]

  @@index([clientId])
  @@index([industryId])
  @@index([provinceId])
  @@index([status])
  @@map("job")
}

// ============ Application (candidate -> job) ============

model Application {
  id Int @id @default(autoincrement())

  jobId Int @map("job_id")
  job   Job @relation(fields: [jobId], references: [id])

  candidateId Int       @map("candidate_id")
  candidate   Candidate @relation(fields: [candidateId], references: [id])

  cvFileUrl    String  @map("cv_file_url") @db.Text
  stampedCvUrl String? @map("stamped_cv_url") @db.Text // MR-logo version

  status ApplicationStatus @default(PENDING)

  reviewedById Int?     @map("reviewed_by_id")
  reviewedBy   MrStaff? @relation(fields: [reviewedById], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@unique([jobId, candidateId])
  @@index([candidateId])
  @@index([status])
  @@index([reviewedById])
  @@map("application")
}

// ============ Util ============

model Industry {
  id        Int      @id @default(autoincrement())
  label     String   @db.Text
  name      String   @unique @db.VarChar(150)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  jobs    Job[]
  clients Client[]

  @@map("industry")
}


model Province {
  id Int @id @default(autoincrement())
  name String  @unique @db.VarChar(100)
  createdAt DateTime @default(now()) @db.Timestamptz() @map("created_at")

  job Job[]

  @@map("province")
}

// ============ Report / Feedback ============

model Report {
  id        Int      @id @default(autoincrement())
  reason    String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@map("report")
}

model Feedback {
  id        Int      @id @default(autoincrement())
  reason    String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@map("feedback")
} 